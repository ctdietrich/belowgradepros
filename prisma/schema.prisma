// BelowGradePros listing directory (PostgreSQL via DATABASE_URL).
// Cloned from the FishTheFlats directory kit; Destination → City, species → services.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // App runtime may rewrite a direct db.prisma.io URL onto the pooled host
  // (see src/lib/prisma.ts). Migrations and introspection use directUrl.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Metro hub (FTF Destination). US national, Wave 1 metros first.
model City {
  id          String        @id @default(cuid())
  slug        String        @unique
  name        String
  state       String
  region      String
  description String
  heroImage   String?
  sortOrder   Int           @default(0)
  listings    ListingCity[]
}

model Listing {
  id             String         @id @default(cuid())
  slug           String         @unique
  type           String         @default("contractor")
  name           String
  tagline        String?
  bio            String
  contactEmail   String
  website        String?
  phone          String?
  homeCity       String?
  homeState      String?
  licenseId      String?
  photos         Json
  /// foundation | encapsulation | both
  primaryService String         @default("foundation")
  /// Additional badges: waterproofing, pier_beam, slab
  services       Json
  featured       Boolean        @default(false)
  founding       Boolean        @default(false)
  foundingAt     DateTime?
  verified       Boolean        @default(false)
  status         String         @default("draft")
  sourceUrl      String?
  claimable      Boolean        @default(true)
  claimedAt      DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  cities         ListingCity[]
  claims         ClaimRequest[]
  leads          Lead[]
}

model ListingCity {
  listingId String
  cityId    String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  city      City    @relation(fields: [cityId], references: [id], onDelete: Cascade)

  @@id([listingId, cityId])
}

model ClaimRequest {
  id        String   @id @default(cuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  name      String
  email     String
  message   String
  founding  Boolean  @default(false)
  status    String   @default("pending")
  createdAt DateTime @default(now())
}

/// Homeowner quote for one listing. Never shared with another contractor.
model Lead {
  id          String    @id @default(cuid())
  listingId   String
  listing     Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingSlug String
  name        String
  email       String?
  phone       String?
  zip         String
  service     String
  message     String
  createdAt   DateTime  @default(now())
  forwardedAt DateTime?
  billedAt    DateTime?

  @@index([listingId, createdAt])
}

model Submission {
  id             String   @id @default(cuid())
  type           String
  name           String
  email          String
  website        String?
  cities         String
  primaryService String   @default("foundation")
  services       String
  bio            String
  founding       Boolean  @default(false)
  status         String   @default("pending")
  createdAt      DateTime @default(now())
}
