{
  "name": "belowgradepros",
  "version": "0.1.0",
  "private": true,
  "description": "BelowGradePros.com — specialty directory for foundation repair and crawl-space/basement encapsulation contractors.",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/with-direct-url.mjs prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "tsx --test src/lib/*.test.ts",
    "test:seo": "tsx --test src/lib/config.test.ts src/lib/hub-densify.test.ts src/lib/jsonld.test.ts",
    "seed": "prisma db seed",
    "import:listings": "tsx scripts/import-listings.ts",
    "db:deploy": "node scripts/with-direct-url.mjs prisma migrate deploy",
    "postinstall": "node scripts/with-direct-url.mjs prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "next": "16.3.5",
    "nodemailer": "^10.0.10",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
