# Postgres (required). Local example; use the Vercel/Neon/Supabase URL in production.
#
# Prisma Postgres on Vercel:
#   DATABASE_URL  pooled TCP  postgres://…@pooled.db.prisma.io:5432/postgres?sslmode=require
#   DIRECT_URL    direct TCP  postgres://…@db.prisma.io:5432/postgres?sslmode=require
# Migrations (`npm run db:deploy`) use DIRECT_URL. If DIRECT_URL is unset, the
# CLI scripts fall back to DATABASE_URL. The app client on Vercel rewrites a
# direct db.prisma.io host to pooled.db.prisma.io and appends
# connection_limit=1&pool_timeout=20 when those params are missing. That rewrite
# is not applied to migrate.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/belowgradepros"
# Same as DATABASE_URL locally. On Vercel set the direct db.prisma.io string
# whenever DATABASE_URL points at the pooler.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/belowgradepros"
ADMIN_PASSWORD="change-me"
# Local canonical. On Vercel Production this is required for SEO:
# NEXT_PUBLIC_SITE_URL=https://belowgradepros.com
# Production never falls back to VERCEL_URL / *.vercel.app.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional Stripe — kept for later billing. Founding is free until the first lead, then $49/mo.
# Build and preview work without these. When ready, set a Payment Link
# (preferred stub) or Checkout keys later.
#
# STRIPE_PAYMENT_LINK is read on the server per request. Prefer this on Vercel.
# NEXT_PUBLIC_STRIPE_PAYMENT_LINK is inlined at build time, so changing it
# does nothing until the next deploy. It is used only when STRIPE_PAYMENT_LINK
# is empty. On Vercel, changing either variable still requires a redeploy
# (the deployment captures env); no code change is required.
NEXT_PUBLIC_STRIPE_PAYMENT_LINK=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_PAYMENT_LINK=""
STRIPE_SECRET_KEY=""
STRIPE_FOUNDING_PRICE_ID=""

# Lead alerts for /submit, /claim, and /founding. The database write always
# happens first. Email never blocks or fails the visitor.
# Recipient defaults to hello@belowgradepros.com.
LEAD_ALERT_TO=""
# Resend from-address. Default: BelowGradePros <hello@belowgradepros.com>
LEAD_ALERT_FROM=""
# If set, alerts POST to the Resend API. Otherwise SMTP is used when both
# SMTP_USER and SMTP_PASS are set. If neither provider is set, the send is
# skipped (a server warning only).
RESEND_API_KEY=""
# Gmail SMTP defaults. SMTP_HOST and SMTP_PORT are optional.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
