# Postgres (required). Local example; use the Vercel/Neon/Supabase URL in production.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/belowgradepros"
ADMIN_PASSWORD="change-me"
# Optional. Canonical site URL for metadata, sitemap, and JSON-LD.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional Stripe — founding / featured listings at $199–299/mo.
# Build and preview work without these. When ready, set a Payment Link
# (preferred stub) or Checkout keys later.
NEXT_PUBLIC_STRIPE_PAYMENT_LINK=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_PAYMENT_LINK=""
STRIPE_SECRET_KEY=""
STRIPE_FOUNDING_PRICE_ID=""
